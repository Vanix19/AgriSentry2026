# Copy this file to .env and point it at your Laravel backend.
# Local phone/emulator on the same Wi-Fi: use your computer's LAN IP, e.g. http://192.168.1.20:8000/api
# Cloudflare/ngrok tunnel: paste the tunnel URL + /api, e.g. https://your-link.trycloudflare.com/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
